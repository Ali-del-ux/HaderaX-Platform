@echo off
chcp 65001 >nul
echo ======================================================================
echo    🚀 تشغيل خادم حاضراكس | HaderaX Server
echo ======================================================================
echo.

:: فحص ما إذا كانت المكتبات مثبتة، وإن لم تكن يقوم بالتشغيل التلقائي للتنصيب
if not exist "backend\node_modules" (
    echo [!] لم يتم العثور على مكتبات Node.js، جارٍ بدء التنصيب التلقائي أولاً...
    call setup.bat
)

echo [*] جارٍ تشغيل خادم Node.js / Express على المنفذ 3000...
echo [*] سيتم فتح المتصفح تلقائياً على http://localhost:3000
echo.

:: فتح المتصفح بعد ثانية واحدة من إطلاق السيرفر
start "" "http://localhost:3000"

:: تشغيل السيرفر
cd backend
node server.js
